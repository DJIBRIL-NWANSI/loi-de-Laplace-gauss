# écrase l'ancienne version multivariée
mvnpdf <- function(x, mean, sd) {
1/(sd*sqrt(2*pi)) * exp(-0.5 * ((x-mean)/sd)^2)
}
rNorm <- function(n, mean, sd) {
rnorm(n, mean=mean, sd=sd)
}
# test
mvnpdf(20.00, 20.00, 0.02) # doit retourner 19.94...
rNorm(5, 20.00, 0.02) # 5 diamètres
mvnpdf <- function(x, mean, sd) {
if (sd <= 0) stop("sd doit être > 0")
1/(sd*sqrt(2*pi)) * exp(-0.5 * ((x-mean)/sd)^2)
}
R.version.string
mvnpdf <- function(x, mean, sd) {
if (sd <= 0) stop("sd doit être > 0")
1/(sd*sqrt(2*pi)) * exp(-0.5 * ((x-mean)/sd)^2)
}
x <- c(1,12,10,14,156,142,1,7,558,695,1351,142)
mean(x)
mean <- 257.4167
sd <- -6
mvnpdf(x,mean,sd)
sd <- 16
mvnpdf(x,mean,sd)
rNorm <- function(n, mean, sd){
u1 <- runif(n)
u2 <- runif(n)
r <- sqrt(-2 * log(u1))
theta <- 2 * pi * u2
x <- r * cos(theta)
return(mean + sd * x)
}
rNorm(10, mean, sd)
