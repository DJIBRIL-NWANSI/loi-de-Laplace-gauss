rNorm <- function(n, mean, sd){
u1 <- runif(n)
u2 <- runif(n)
r <- sqrt(-2 * log(u1))
theta <- 2 * pi * u2
x <- r * cos(theta)
return(mean + sd * x)
}
rNorm(10, mean, sd)
tracer_dispersion_qc <- function(x, lsl, usl){
if(!is.numeric(x)){
stop("Le vecteur d'entrée 'x' doit etre de type numerique.")
}
if(lsl>=usl){
stop("La limite inferieure (lsl) doit etre strictement inferieure à la limite supérieure (usl).")
}
x <- stats::na.omit(x)
mu <- mean(x)
sigma <- sd(x)
cp <- (usl-lsl)/(6*sigma)
cpk_inf <- (mu-lsl)/(3*sigma)
cpk_sup <- (usl-mu)/(3*sigma)
cpk <- min(cpk_inf, cpk_sup)
hist(x, probability = TRUE, col = "aliceblue", border = "steelblue", main = "Controle Qualité : Loi de Laplace-Gauss", xlab = "Valeurs mesurées", ylab = "Densité de probabilité")
curve(stats::dnorm(x, mean = mu, sd = sigma), col = "darkblue", lwd = 2, add = TRUE)
abline(v = c(lsl,usl), col = "red", lty = 2, lwd = 2)
abline(v = mu, col = "darkgreen", lty = 1, lwd = 2)
legend("topright",
legend = c("Courbe Normale", "Limites Usine (LSL/USL)", "Moyenne(mu)"),
col = c("darkblue", "red", "darkgreen"),
lwd = 2, lty = c(1,2,1), bty = "n")
metriques <- list(etendue = max(x)-min(x),
variance = var(x),
Cp = cp,
Cpk = cpk
)
return(metriques)
}
analyser_conformite <- function(x, lsl, usl) {
if (!is.numeric(x)){
stop("Le vecteur d'entrée 'x' doit etre de type numerique.")
}
if(lsl>=usl){
stop("La limite inférieure (lsl) doit etre strictement inférieure à la limite superieure (usl).")
}
x <- stats::na.omit(x)
mu <- mean(x)
sigma <- sd(x)
prob_theorique <- stats::pnorm(usl, mean = mu, sd = sigma)
test_normalite <- stats::shapiro.test(x)
resultats <- list(moyenne = mu, ecart_type = sigma, probabilite_theorique = prob_theorique, proportion_empirique = prop_empirique, test_normalite = test_normalite)
class(resultats) <- "conforme_qc"
return(resultats)
}
donnees_test <- rnorm(100, mean = 50, sd = 2)
analyser_conformite(donnees_test, lsl = 44, usl = 56)
analyser_conformite(donnees_test, lsl = 44, usl = 56)
analyser_conformite <- function(x, lsl, usl) {
if (!is.numeric(x)){
stop("Le vecteur d'entrée 'x' doit etre de type numerique.")
}
if(lsl>=usl){
stop("La limite inférieure (lsl) doit etre strictement inférieure à la limite superieure (usl).")
}
x <- stats::na.omit(x)
mu <- mean(x)
sigma <- sd(x)
prob_theorique <- stats::pnorm(usl, mean = mu, sd = sigma)-stats::pnorm(lsl, mean = mu, sd = sigma)
prop_empirique <- mean(x >= lsl & x <= usl)
test_normalite <- stats::shapiro.test(x)
resultats <- list(moyenne = mu, ecart_type = sigma, probabilite_theorique = prob_theorique, proportion_empirique = prop_empirique, test_normalite = test_normalite)
class(resultats) <- "conforme_qc"
return(resultats)
}
donnees_test <- rnorm(100, mean = 50, sd = 2)
analyser_conformite(donnees_test, lsl = 44, usl = 56)
tracer_dispersion_qc(donnees_test, lsl = 44, usl = 56)
donnees_test <- rnorm(1000, mean = 100, sd = 4)
analyser_conformite(donnees_test, lsl = 60, usl = 50)
analyser_conformite(donnees_test, lsl = 60, usl = 75)
tracer_dispersion_qc(donnees_test, lsl = 60, usl = 75)
